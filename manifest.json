{
  "name": "Multi Provider Repository",
  "version": "1.2.0",
  "description": "Dexter.pw ve IDLIX kaynak sağlayıcıları",
  "scrapers": [
    {
      "id": "dexterpw",
      "name": "Dexter.pw",
      "version": "1.0.7",
      "filename": "providers/dexterpw.js",
      "supportedTypes": ["movie", "tv"],
      "enabled": true
    },
    {
      "id": "idlix",
      "name": "IDLIX",
      "version": "1.0.2",
      "filename": "providers/idlix.js",
      "supportedTypes": ["movie", "tv"],
      "enabled": true,
      "settings": [
        {
          "key": "cf_clearance_cookie",
          "label": "IDLIX cf_clearance Cookie",
          "description": "IDLIX sitesine erişmek için gerekli olan Cloudflare çerezini buraya yapıştırın.",
          "type": "text", 
          "default": ""
        }
      ]
    }
  ]
}
