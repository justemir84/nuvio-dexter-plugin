{
  "name": "Multi Provider Repository",
  "version": "1.5.0",
  "description": "Dexter.pw, IDLIX, KMMovies ve YTS kaynak sağlayıcıları",
  "scrapers": [
    {
      "id": "dexterpw",
      "name": "Dexter.pw",
      "version": "1.0.8",
      "filename": "providers/dexterpw.js",
      "supportedTypes": ["movie", "tv"],
      "enabled": true,
      "hasSettings": false
    },
    {
      "id": "idlix",
      "name": "IDLIX",
      "version": "1.0.3",
      "description": "IDLIX provider with cf_clearance cookie support",
      "filename": "providers/idlix.js",
      "supportedTypes": ["movie", "tv"],
      "enabled": true,
      "hasSettings": true,
      "formats": ["m3u8"],
      "contentLanguage": ["en", "id"]
    },
    {
      "id": "kmmovies",
      "name": "KMMovies",
      "version": "1.0.0",
      "filename": "providers/kmmovies.js",
      "supportedTypes": ["movie", "tv"],
      "enabled": true,
      "hasSettings": false,
      "formats": ["mkv", "mp4"],
      "contentLanguage": ["en", "hi"]
    },
    {
      "id": "yts",
      "name": "YTS",
      "version": "1.0.0",
      "description": "YTS torrent provider (magnet, debrid gerektirir)",
      "filename": "providers/yts.js",
      "supportedTypes": ["movie", "tv"],
      "enabled": true,
      "hasSettings": false,
      "formats": ["mp4"],
      "contentLanguage": ["en"]
    }
  ]
}
